[gd_resource type="Resource" script_class="DiscoveryDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/discovery/discovery_definition.gd" id="1_discovery"]

[resource]
script = ExtResource("1_discovery")
discovery_id = &"cable_scarred_junction"
title = "An erased service junction"
observation = "Several thick lines converge at a junction. Somebody scraped away its old service marks."
hypothesis = "The markings might have identified a destination or maintenance access."
personal_plan = "Look for similar markings on another machine, if you want to."
bark_event = &"noticed_junction"
