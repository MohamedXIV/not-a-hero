[gd_resource type="Resource" script_class="DiscoveryDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/discovery/discovery_definition.gd" id="1_discovery"]

[resource]
script = ExtResource("1_discovery")
discovery_id = &"foundry_shift_cycle"
title = "A press still following a shift"
observation = "The empty press moves on a repeating cycle. There is no operator, but its timing keeps resetting."
hypothesis = "It could be taking its timing from a working network farther away."
personal_plan = "Listen to one full cycle again, Yuna, or see if something else follows the same rhythm."
bark_event = &"noticed_foundry"
