[gd_resource type="Resource" script_class="DiscoveryDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/discovery/discovery_definition.gd" id="1_discovery"]

[resource]
script = ExtResource("1_discovery")
discovery_id = &"basin_reverse_flow"
title = "Coolant against the slope"
observation = "An active siphon lifts coolant against the basin's natural slope. The pump pulses at regular intervals."
hypothesis = "It might be answering a timed demand from machinery beyond this channel."
personal_plan = "Compare the pulse with the foundry machinery if you've heard it, Yuna."
bark_event = &"noticed_basin"
