[gd_resource type="Resource" script_class="DiscoveryDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/discovery/discovery_definition.gd" id="1_discovery"]

[resource]
script = ExtResource("1_discovery")
discovery_id = &"basin_return_manifold"
title = "A service return beneath the ridge"
observation = "A coolant-return manifold pulses regularly. Its sealed outlet runs beneath the raised eastern stone shelf; machine treads have worn down the surrounding rock."
hypothesis = "Something beneath or beyond the shelf may be calling for coolant. A machine could have tried to reach the buried line."
personal_plan = "Remember the beat, Yuna. Maybe another machine somewhere keeps the same time."
bark_event = &"noticed_return_manifold"
