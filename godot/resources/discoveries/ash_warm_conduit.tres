[ext_resource type="Script" path="res://scripts/discovery/discovery_definition.gd" id="1_discovery"]

[resource]
script = ExtResource("1_discovery")
discovery_id = &"ash_warm_conduit"
title = "A conduit that is still warm"
observation = "The cable buried beneath the Ash Flats is warm, even though its casing is old. It carries power east."
hypothesis = "Something beyond the flats might still be drawing current."
personal_plan = "Maybe follow the cable route when you feel ready, Yuna."
bark_event = &"noticed_conduit"
