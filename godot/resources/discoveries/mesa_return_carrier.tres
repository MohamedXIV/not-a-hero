[gd_resource type="Resource" script_class="DiscoveryDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/discovery/discovery_definition.gd" id="1_discovery"]

[resource]
script = ExtResource("1_discovery")
discovery_id = &"mesa_return_carrier"
title = "The mesa's unanswered service carrier"
observation = "A powered return terminal repeats a maintenance acknowledgement into the buried water-and-power lines. The return circuit is active, but the terminal reveals neither its original sender nor the machinery's final purpose."
hypothesis = "The repeating acknowledgement could explain why the nearby service machine approaches the hatch. It does not tell me what else is deep below."
personal_plan = "You could send the return to an old service reflector instead, Yuna. Or leave the machines to their work."
bark_event = &"noticed_mesa_carrier"
