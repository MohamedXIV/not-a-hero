extends SceneTree
## Independent clue ordering, authored evidence gating, no quest log.

func _initialize() -> void:
    call_deferred("_check")


func _check() -> void:
    var notes := NotebookState.new()
    assert(notes.observed_ids().is_empty() and notes.inference().is_empty(), "Start with no hidden clues")
    assert(not notes.pin("ash_warm_conduit"), "Cannot pin facts before seeing them")
    assert(not notes.discover("not_authored"), "Unknown world fact cannot be discovered")
    assert(notes.discover("cable_scarred_junction"), "Cable observation found first")
    assert(notes.inference().is_empty(), "Second clue must not leak early")
    assert(not notes.discover("cable_scarred_junction"), "Re-examination doesn't duplicate")
    assert(notes.pin("cable_scarred_junction"), "Pin a witnessed note")
    assert(notes.discover("ash_warm_conduit"), "Ash observation found second")
    assert(not notes.inference().is_empty(), "Two known clues yield a tentative inference")
    var reversed := NotebookState.new()
    assert(reversed.discover("ash_warm_conduit") and reversed.discover("cable_scarred_junction"), "Reverse order valid")
    assert(reversed.inference() == notes.inference(), "Order doesn't gate deduction")
    # Each future mesa approach is grounded by only TWO witnessed clues.
    # Neither route needs the other's evidence or a random maintenance event.
    var power := NotebookState.new()
    assert(power.discover("cable_eastbound_feeder"), "Eastbound feeder physically inspectable alone")
    assert(power.mesa_leads().is_empty(), "One clue cannot invent a destination")
    assert(power.related_inferences("cable_eastbound_feeder").is_empty(), "No premature page inference")
    assert(power.discover("ash_warm_conduit"), "Can discover the other power clue later")
    assert(power.mesa_leads() == ["eastern_power"], "Power route stands independently")
    assert(not power.knows("foundry_shift_cycle") and not power.knows("basin_return_manifold"), "Power never leaks machine-service route")
    assert(power.related_inferences("ash_warm_conduit")[0].contains("eastern stone shelf"), "Power inference is grounded")
    var mechanical := NotebookState.new()
    assert(mechanical.discover("basin_return_manifold"), "Can inspect coolant return first")
    assert(mechanical.mesa_leads().is_empty(), "Return manifold alone reveals no destination")
    assert(mechanical.discover("foundry_shift_cycle"), "Machine press is independent second source")
    assert(mechanical.mesa_leads() == ["eastern_service"], "Machine service route stands independently")
    assert(not mechanical.knows("ash_warm_conduit"), "Machine service route has no invisible power evidence")
    assert(mechanical.related_inferences("foundry_shift_cycle")[0].contains("eastern shelf"), "Service route has relevant hypothesis")
    var both := NotebookState.new()
    for clue: String in ["foundry_shift_cycle", "ash_warm_conduit", "cable_eastbound_feeder", "basin_return_manifold"]:
        assert(both.discover(clue), "All physical evidence can be found in any order")
    assert(both.mesa_leads().size() == 2, "Both approaches can coexist")
    assert(both.related_inferences("ash_warm_conduit").size() == 1, "Only relevant page conclusions are displayed")
    assert(both.related_inferences("foundry_shift_cycle").size() == 1, "Unrelated discoveries stay on their own pages")
    var saved: Dictionary = notes.snapshot()
    var loaded := NotebookState.new()
    assert(loaded.restore_snapshot(JSON.parse_string(JSON.stringify(saved))), "Observed notes survive JSON")
    assert(loaded.snapshot() == saved, "Notes and pinned state roundtrip")
    var before: Dictionary = loaded.snapshot()
    var invalid: Dictionary = before.duplicate(true)
    invalid["observed"].append("secret_mesa_code")
    assert(not loaded.restore_snapshot(invalid) and loaded.snapshot() == before, "Unknown secrets rejected atomically")
    invalid = before.duplicate(true)
    invalid["observed"].append("ash_warm_conduit")
    assert(not loaded.restore_snapshot(invalid) and loaded.snapshot() == before, "Repeated discovered ID rejected")
    invalid = before.duplicate(true)
    invalid["pinned"] = "secret_mesa_code"
    assert(not loaded.restore_snapshot(invalid) and loaded.snapshot() == before, "Unseen pin rejected")
    assert(notes.pin("cable_scarred_junction") and notes.pinned.is_empty(), "Pin can be removed")
    print("PASS: discovery notes are witnessed, order independent, non-duplicated and validated")
    quit(0)
